<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS hosting for OrderDesk via HttpPlatformHandler.

  IIS owns port 8080, starts python.exe as the app-pool identity, passes the
  child a free port in %HTTP_PLATFORM_PORT%, and reverse-proxies to it.

  Deploy-LabApp.ps1 rewrites processPath and the ORDERDESK_* values below to
  match the VM, so edit this file for structure and let the script set paths.

  Nothing here holds a password: SQL access is Integrated Security as the
  app-pool identity, which is what makes failure 1 (bad service-account
  password) and failure 4 (permission denied) distinguishable in the lab.
-->
<configuration>
  <system.webServer>

    <handlers>
      <!-- Remove inherited handlers so nothing else claims the request. -->
      <clear />
      <add name="httpPlatformHandler"
           path="*"
           verb="*"
           modules="httpPlatformHandler"
           resourceType="Unspecified"
           requireAccess="Script" />
    </handlers>

    <httpPlatform processPath="C:\Python312\python.exe"
                  arguments="&quot;C:\inetpub\OrderDesk\app.py&quot;"
                  stdoutLogEnabled="true"
                  stdoutLogFile="C:\inetpub\OrderDesk\logs\httpplatform-stdout"
                  startupTimeLimit="60"
                  startupRetryCount="2"
                  requestTimeout="00:02:00"
                  forwardWindowsAuthToken="false">
      <environmentVariables>
        <environmentVariable name="ORDERDESK_DB_BACKEND"           value="mssql" />
        <environmentVariable name="ORDERDESK_SQL_SERVER"           value="localhost\SQLEXPRESS" />
        <environmentVariable name="ORDERDESK_SQL_DATABASE"         value="AppSupportLab" />
        <environmentVariable name="ORDERDESK_SQL_DRIVER"           value="ODBC Driver 18 for SQL Server" />
        <environmentVariable name="ORDERDESK_SQL_TRUSTED"          value="yes" />
        <environmentVariable name="ORDERDESK_SQL_ENCRYPT"          value="yes" />
        <environmentVariable name="ORDERDESK_SQL_TRUST_SERVER_CERT" value="yes" />
        <environmentVariable name="ORDERDESK_SQL_LOGIN_TIMEOUT"    value="5" />
        <environmentVariable name="ORDERDESK_LOG_DIR"              value="C:\inetpub\OrderDesk\logs" />
        <environmentVariable name="PYTHONUNBUFFERED"               value="1" />
        <environmentVariable name="PYTHONDONTWRITEBYTECODE"        value="1" />
      </environmentVariables>
    </httpPlatform>

    <!-- Show real errors locally; a lab server is not production. -->
    <httpErrors errorMode="Detailed" />

    <security>
      <requestFiltering>
        <!-- Never serve the app's own source or logs over HTTP. -->
        <hiddenSegments>
          <add segment="logs" />
          <add segment="__pycache__" />
          <add segment=".venv" />
        </hiddenSegments>
        <fileExtensions allowUnlisted="true">
          <add fileExtension=".py" allowed="false" />
          <add fileExtension=".config" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>

  </system.webServer>
</configuration>
